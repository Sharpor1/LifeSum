{
  "name": "lifesum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix frontEnd install && npm --prefix backEnd install",
    "dev:front": "npm --prefix frontEnd run dev",
    "dev:back": "npm --prefix backEnd run dev",
    "build:front": "npm --prefix frontEnd run build",
    "build:back": "npm --prefix backEnd run build",
    "build:all": "npm run build:front && npm run build:back",
    "typecheck:front": "npm --prefix frontEnd run typecheck",
    "typecheck:back": "npm --prefix backEnd run typecheck",
    "typecheck": "npm run typecheck:front && npm run typecheck:back",
    "start": "npm --prefix backEnd run start",
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\""
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
